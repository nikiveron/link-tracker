{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka-1:9092,kafka-2:9093,kafka-3:9094",
    "InputTopic": "link.raw-updates",
    "OutputTopic": "link.processed-updates"
  },
  "AiAgent": {
    "Filtering": {
      "StopWords": [ "spam", "ads", "promo" ],
      "ExcludedAuthors": [ "bot-user" ]
    },
    "MinLength": 20,
    "Summarization": {
      "Threshold": 100
    },
    "Prioritization": {
      "HighKeywords": [ "critical", "urgent", "breaking", "security" ],
      "LowKeywords": [ "minor", "typo", "chore", "docs" ]
    },
    "Grouping": {
      "WindowMs": 30000
    }
  }
}
