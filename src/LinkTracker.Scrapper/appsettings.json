{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=chats_db;Username=postgres;Password=postgres;"
  },
  "Notification": {
    "Mode": "Kafka"
  },
  "Kafka": {
    "BootstrapServers": "kafka-1:9092,kafka-2:9093,kafka-3:9094",
    "Topic": "link.raw-updates"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "AccessType": "ORM"
  },
  "ScrapperOptions": {
    "SchedulerIntervalSeconds": 30,
    "BatchSize": 100
  },
  "Cache": {
    "Enabled": true,
    "TtlSeconds": 300
  },
  "Valkey": {
    "Configuration": "valkey-node-1:6379,valkey-node-2:6380,valkey-node-3:6381"
  },
  "Resilience": {
    "TimeoutSeconds": 5,
    "RetryCount": 3,
    "RetryDelayMilliseconds": 1000,
    "RetryableStatusCodes": [ 500, 502, 503, 504 ],
    "CircuitBreaker": {
      "FailureRateThreshold": 0.5,
      "MinimumThroughput": 5,
      "SamplingDurationSeconds": 10,
      "BreakDurationSeconds": 15,
      "PermittedCallsInHalfOpenState": 2
    }
  },
  "RateLimiting": {
    "PermitLimit": 5,
    "WindowSeconds": 10
  }
}