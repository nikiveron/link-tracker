{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kafka": {
    "BootstrapServers": "kafka-1:9092,kafka-2:9093,kafka-3:9094",
    "Topic": "link.processed-updates"
  },
  "AllowedHosts": "*",
  "Proxy": {
    "Type": "Http",
